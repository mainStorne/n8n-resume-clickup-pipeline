      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.cv_queue\nSET status = 'processing',\n    attempts = attempts + 1,\n    consumer_id = 1,\n    started_at = now()\nWHERE id IN (\n    SELECT id FROM public.cv_queue\n    WHERE status = 'pending'\n    ORDER BY id ASC\n    LIMIT 10\n    FOR UPDATE SKIP LOCKED\n)\nRETURNING *",
